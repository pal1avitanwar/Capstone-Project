              <calculation class='tableau' formula='IF [dq_missing_account] = 1 THEN &quot;Missing Account ID&quot;&#13;&#10;ELSEIF [dq_missing_date] = 1 THEN &quot;Missing Timestamp&quot;&#13;&#10;ELSEIF [dq_missing_amount] = 1 THEN &quot;Invalid/Missing Amount&quot;&#13;&#10;ELSE &quot;Included&quot;&#13;&#10;END' />
