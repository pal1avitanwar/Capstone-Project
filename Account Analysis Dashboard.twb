    <worksheet name='d3 kpi'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_transactions+' name='federated.1ekv6ev05v51ds1gxzty01ha6scj' />
          </datasources>
          <datasource-dependencies datasource='federated.1ekv6ev05v51ds1gxzty01ha6scj'>
            <column caption='0' datatype='integer' name='[Calculation_1006666688434184]' role='measure' type='quantitative' user:unnamed='d3 kpi'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Branch Risk Rate' datatype='real' default-format='p0.00%' name='[Calculation_1006666693611535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([transaction_id]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    COUNTD(&#13;&#10;        IF [risk_severity] = &quot;High&quot;&#13;&#10;        THEN [transaction_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    COUNTD([transaction_id])&#13;&#10;END' />
            </column>
            <column caption='High Risk Branches' datatype='integer' name='[Calculation_1006666702893072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;{FIXED [branch_id]:&#13;&#10;IF COUNTD([transaction_id])&gt;0&#13;&#10;AND  [Calculation_1006666693611535]&gt;0.20&#13;&#10;THEN 1 ELSE 0 &#13;&#10;END&#13;&#10;}&#13;&#10;)' />
            </column>
            <column caption='Branch Risk Rate %' datatype='real' default-format='p0%' name='[Calculation_1592432628133888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([transaction_id]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    COUNTD(&#13;&#10;        IF [risk_severity] = &quot;High&quot;&#13;&#10;        THEN [transaction_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    COUNTD([transaction_id])&#13;&#10;END' />
            </column>
