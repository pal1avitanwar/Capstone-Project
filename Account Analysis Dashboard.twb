      <column caption='Risk Flagged Category' datatype='string' name='[Calculation_0559715142955031]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0559715140739091] = 1 THEN&#13;&#10;    IF [Calculation_0559715141976086] &gt; 0 THEN &quot;Risk-Flagged Transaction&quot;&#13;&#10;    ELSE &quot;Clean Transaction&quot;&#13;&#10;    END&#13;&#10;ELSE &quot;Excluded Transaction&quot;&#13;&#10;END' />
      </column>
      <column caption='model_score' datatype='real' name='[Calculation_0933548721250304]' role='measure' type='quantitative'>
