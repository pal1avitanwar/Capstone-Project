    <worksheet name='d3 branch detail table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'>Branch Detail Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_transactions+' name='federated.1ekv6ev05v51ds1gxzty01ha6scj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Balance Threshold' datatype='integer' name='[Parameter 1234267001024514]' param-domain-type='range' role='measure' type='quantitative' value='-49000'>
              <calculation class='tableau' formula='-49000' />
              <range granularity='1000' max='-10000' min='-80000' />
            </column>
            <column caption='High-Value Txn Threshold' datatype='integer' name='[Parameter 1234267004141573]' param-domain-type='range' role='measure' type='quantitative' value='90000'>
              <calculation class='tableau' formula='90000' />
              <range granularity='10000' max='150000' min='10000' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ekv6ev05v51ds1gxzty01ha6scj'>
            <column caption='Dormant Accounts' datatype='integer' name='[Calculation_0559714991607814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;if [Status] = &quot;Dormant&quot;&#13;&#10;then [account_id (accounts_1.csv)]&#13;&#10;end &#13;&#10;)' />
            </column>
            <column caption='Credit Utilization %' datatype='real' default-format='p0.00%' name='[Calculation_0559714992070663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [account_type] = &quot;CreditCard&quot;&#13;&#10;       AND [Sum of credit_limit] &gt; 0&#13;&#10;       AND NOT ISNULL([Sum of current_balance])&#13;&#10;    THEN [Sum of current_balance]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [account_type] = &quot;CreditCard&quot;&#13;&#10;       AND [Sum of credit_limit] &gt; 0&#13;&#10;       AND NOT ISNULL([Sum of current_balance])&#13;&#10;    THEN [Sum of credit_limit]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Account Credit Utilization' datatype='real' default-format='p0.00%' name='[Calculation_0559714998140938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [account_type] = &quot;CreditCard&quot;&#13;&#10;AND [Sum of credit_limit] &gt; 0&#13;&#10;AND NOT ISNULL([Sum of current_balance])&#13;&#10;THEN&#13;&#10;    [Sum of current_balance] / [Sum of credit_limit]&#13;&#10;END' />
            </column>
            <column caption='High Risk Transaction Count' datatype='integer' name='[Calculation_0559715121393676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_0933548743581708] = 1&#13;&#10;    THEN [transaction_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Overdrawn Exposure   ' datatype='real' name='[Calculation_0559715131015181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if NOT ISNULL([Sum of current_balance]) &#13;&#10;and [Sum of current_balance] &lt;0 &#13;&#10;then ABS([Sum of current_balance])&#13;&#10;end&#13;&#10;)' />
            </column>
            <column caption='Extreme Negative Accounts' datatype='integer' name='[Calculation_0559715132846095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;if NOT ISNULL([Sum of current_balance])&#13;&#10;and [Sum of current_balance]&lt;=[Parameters].[Parameter 1234267001024514]&#13;&#10;then [account_id]&#13;&#10;end)' />
            </column>
            <column caption='Exclusion Reason' datatype='string' name='[Calculation_0559715140636690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [dq_missing_account] = 1 THEN &quot;Missing Account ID&quot;&#13;&#10;ELSEIF [dq_missing_date] = 1 THEN &quot;Missing Timestamp&quot;&#13;&#10;ELSEIF [dq_missing_amount] = 1 THEN &quot;Invalid/Missing Amount&quot;&#13;&#10;ELSE &quot;Included&quot;&#13;&#10;END' />
            </column>
            <column caption='Is Valid Transaction' datatype='integer' name='[Calculation_0559715140739091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0559715140636690] = &quot;Included&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Txn Risk Flag Count' datatype='integer' name='[Calculation_0559715141976086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [transaction_id] : COUNTD(IF [dq_missing_account] = 0 THEN [risk_flag_id] END) }' />
            </column>
            <column caption='Total Txn FIXED' datatype='integer' name='[Calculation_0861532832989186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : COUNTD([transaction_id]) }' />
            </column>
            <column caption='Total Risk Flags FIXED' datatype='integer' name='[Calculation_0861532839702531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : COUNTD([risk_flag_id]) }' />
            </column>
            <column caption='model_score' datatype='real' name='[Calculation_0933548721250304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([model_score],0)' />
            </column>
            <column caption='Balance after txn' datatype='real' name='[Calculation_0933548722028545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([balance_after_txn],0)' />
            </column>
            <column caption='Risk Flag Count' datatype='integer' name='[Calculation_0933548727185414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([risk_flag_id])' />
            </column>
            <column caption='Fraud-Suspected Transactions' datatype='integer' name='[Calculation_0933548729753609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if &#13;&#10;[Calculation_0933548743581708]=1  AND NOT ISNULL([transaction_id (cleaned_risk_flag.csv)])&#13;&#10;then &#13;&#10;[transaction_id (cleaned_risk_flag.csv)]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='High-Risk Transaction%' datatype='real' default-format='p0.00%' name='[Calculation_0933548732149770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(if [risk_severity]=&quot;High&quot;&#13;&#10;then [transaction_id (cleaned_risk_flag.csv)]&#13;&#10;end )&#13;&#10;/&#13;&#10;[Calculation_0933548727185414]' />
            </column>
            <column caption='fraud suspected flag' datatype='integer' name='[Calculation_0933548743581708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    (UPPER(TRIM([risk_code])) = &quot;GEO_MISMATCH&quot;&#13;&#10;     AND UPPER(TRIM([risk_severity])) IN (&quot;MEDIUM&quot;, &quot;HIGH&quot;))&#13;&#10;    OR&#13;&#10;    (UPPER(TRIM([risk_code])) IN&#13;&#10;        (&quot;VELOCITY&quot;, &quot;BENEFICIARY_RISK&quot;, &quot;NEW_DEVICE&quot;)&#13;&#10;     AND UPPER(TRIM([risk_severity])) = &quot;HIGH&quot;)&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Dormant Account ct' datatype='integer' name='[Calculation_1006666647265280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;if [Status] = &quot;Dormant&quot;&#13;&#10;then [account_id (accounts_1.csv)]&#13;&#10;end &#13;&#10;)' />
            </column>
            <column caption='Closed Account Activity' datatype='integer' name='[Calculation_1006666652532738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [Status] = &quot;Closed&quot; then [transaction_id] END)' />
            </column>
            <column caption='Dormant  Closed Account Activity' datatype='integer' name='[Calculation_1006666652930051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [Status] =&quot;Dormant&quot; or [Status]=&quot;Closed&quot; then [transaction_id] end)' />
            </column>
            <column caption='High-Risk Transactions' datatype='integer' name='[Calculation_1006666689122313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [risk_severity] = &quot;High&quot;&#13;&#10;    THEN [transaction_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='High Risk %' datatype='real' default-format='p0.00%' name='[Calculation_1006666689458186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1406888345354241] = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    [Calculation_1006666689122313] / [Calculation_1406888345354241]&#13;&#10;END' />
            </column>
            <column caption='Average Risk Flags per Transaction' datatype='real' default-format='p0.00%' name='[Calculation_1006666690158603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1406888345354241] = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    SUM([Calculation_0559715141976086]) / [Calculation_1406888345354241]&#13;&#10;END' />
            </column>
            <column caption='Unknown-Branch Transactions' datatype='integer' name='[Calculation_1006666690523148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [dq_missing_branch] = 1&#13;&#10;    THEN [transaction_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Branch Risk Rate' datatype='real' default-format='p0.00%' name='[Calculation_1006666693611535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([transaction_id]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    COUNTD(&#13;&#10;        IF [risk_severity] = &quot;High&quot;&#13;&#10;        THEN [transaction_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    COUNTD([transaction_id])&#13;&#10;END' />
            </column>
            <column caption='High Risk Branches' datatype='integer' name='[Calculation_1006666702893072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;{FIXED [branch_id]:&#13;&#10;IF COUNTD([transaction_id])&gt;0&#13;&#10;AND  [Calculation_1006666693611535]&gt;0.20&#13;&#10;THEN 1 ELSE 0 &#13;&#10;END&#13;&#10;}&#13;&#10;)' />
            </column>
            <column caption='Net  Transactions Amount' datatype='real' name='[Calculation_1006666713514001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([amount])-[Calculation_1406888345903107]' />
            </column>
            <column caption='High-Value Transactions' datatype='integer' name='[Calculation_1006666717028373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [amount]&gt;= [Parameters].[Parameter 1234267004141573]&#13;&#10;then  [transaction_id]&#13;&#10;END)' />
            </column>
            <column caption='Transaction Hour' datatype='integer' name='[Calculation_1006667005882391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [transaction_date])' />
            </column>
            <column caption='Total Transactions amt FIXED' datatype='real' name='[Calculation_1234266998104064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :SUM(ABS([amount])) }' />
            </column>
            <column caption='Fraud Suspect FIXED' datatype='integer' name='[Calculation_1234266999214081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if &#13;&#10;[Calculation_0933548743581708]=1  AND NOT ISNULL([transaction_id (cleaned_risk_flag.csv)])&#13;&#10;then &#13;&#10;[transaction_id (cleaned_risk_flag.csv)]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Transactions Volume' datatype='integer' name='[Calculation_1406888345108480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([transaction_id])' />
            </column>
            <column caption='Total Transactions' datatype='real' name='[Calculation_1406888345354241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(abs([amount]))' />
            </column>
            <column caption='Average Transaction Amount' datatype='real' name='[Calculation_1406888345673730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(abs([amount]))' />
            </column>
            <column caption='Total Credit Amount' datatype='real' name='[Calculation_1406888345903107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [txn_type]=&quot;Credit&quot;&#13;&#10;then abs([amount])&#13;&#10;else 0 &#13;&#10;end &#13;&#10;)' />
            </column>
            <column caption='Total Debit Amount' datatype='real' name='[Calculation_1406888346304516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;if [txn_type] =&quot;Debit&quot;&#13;&#10;then abs([amount])&#13;&#10;else 0 &#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Credit Transaction Count ' datatype='integer' name='[Calculation_1406888346722309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;if [txn_type] = &quot;Credit&quot;&#13;&#10;then [transaction_id]&#13;&#10;END)' />
            </column>
            <column caption='Debit Transaction Count' datatype='integer' name='[Calculation_1406888347103238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;if [txn_type] = &quot;Dedit&quot;&#13;&#10;then [transaction_id]&#13;&#10;END)' />
            </column>
            <column caption='Branch Risk Rate %' datatype='real' default-format='p0%' name='[Calculation_1592432628133888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([transaction_id]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    COUNTD(&#13;&#10;        IF [risk_severity] = &quot;High&quot;&#13;&#10;        THEN [transaction_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    COUNTD([transaction_id])&#13;&#10;END' />
            </column>
            <column caption='Total Risk Flags' datatype='integer' name='[Calculation_1592432629534721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([risk_flag_id])' />
            </column>
            <column caption='Eligible Transaction Flag' datatype='integer' name='[Calculation_1594630166339585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Eligible Transaction Count' datatype='integer' name='[Calculation_1594630166573058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1594630166339585] = 1&#13;&#10;    THEN [transaction_id (cleaned_risk_flag.csv)]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Account Balance Exposure' datatype='real' name='[Calculation_1594630209318917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Sum of current_balance])' />
            </column>
            <column caption='Negative Balance Account' datatype='integer' name='[Calculation_1594630211997702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([Sum of current_balance])&#13;&#10;       AND [Sum of current_balance] &lt;0&#13;&#10;    THEN [account_id (accounts_1.csv)]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column datatype='string' name='[Status]' role='dimension' type='nominal' />
            <column caption='Sum of Current Balance Flag' datatype='integer' name='[Sum of Current_Balance_Flag]' role='measure' type='quantitative' />
            <column caption='Sum of credit limit' datatype='integer' name='[Sum of credit_limit]' role='measure' type='quantitative' />
